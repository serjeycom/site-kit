{
  "name": "@serjeycom/site-kit",
  "version": "0.1.1",
  "description": "Shared semantic tokens, UI primitives and lint config for Serjey sites",
  "type": "module",
  "sideEffects": ["./tokens.css"],
  "files": ["src", "tokens.css", "eslint-config.mjs", "README.md"],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./eslint-config": "./eslint-config.mjs"
  },
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0"
  }
}
